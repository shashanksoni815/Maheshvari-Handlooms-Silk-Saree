# Server
NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/maheshwari-silk

# JWT Secrets (generate strong random strings)
JWT_ACCESS_SECRET=your_access_token_secret_here
JWT_REFRESH_SECRET=your_refresh_token_secret_here
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay: use the Key ID and Key Secret from Razorpay Dashboard > Account & Settings > API Keys.
# Keep the secret on the server only. Replace both placeholders with test keys first.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Create a webhook in Razorpay Dashboard pointing to https://<your-api-host>/api/v1/payments/webhook.
# Use a separate webhook secret and subscribe to payment.captured (and optionally order.paid).
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# SMTP email delivery (required for forgot-password and password-change emails)
# Use the SMTP settings supplied by your email provider. Port 587 uses STARTTLS;
# port 465 uses implicit TLS. Do not commit the populated server/.env file.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password_or_app_password
FROM_NAME=Maheshwari Handlooms
FROM_EMAIL=no-reply@example.com
